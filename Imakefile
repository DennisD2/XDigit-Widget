
#include <widgets.tmpl>

#ifndef LinuxArchitecture
CCOPTIONS       =-Wall -I/usr/local/include
#else
CCOPTIONS       =-Wall
#endif
#INCLUDES        += 

#ifndef LinuxArchitecture
LDOPTIONS       += -L. -L/usr/local/lib
#else
LDOPTIONS       += -L.
#endif

LOCAL_LIBRARIES = -lWidgets -lXm
#  EXTRA_DEFINES =
EXTENSIONLIB     =
#DEPLIBS         = $(DEPXLIB)
#SYS_LIBRARIES   +=

PROGRAM       	= libWidgets.a xdigit multi-zone-clock listfonts

SRCS	      	= Digit.c 
SRCS1 		    = xdigit.c
SRCS2 		    = multi-zone-clock.c
SRCS3 		    = listfonts.c

OBJS          	= Digit.o
OBJS1 		    = xdigit.o
OBJS2 		    = multi-zone-clock.o
OBJS3 		    = listfonts.o

PROGRAMS        = $(PROGRAM)

all:: install $(PROGRAMS)

NormalLibraryTarget(Widgets,$(OBJS))

NormalProgramTarget(xdigit,$(OBJS1),,$(LOCAL_LIBRARIES),)

NormalProgramTarget(multi-zone-clock,$(OBJS2),,$(LOCAL_LIBRARIES),)

NormalProgramTarget(listfonts,$(OBJS3),,$(LOCAL_LIBRARIES),)

